# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Caminho do arquivo SQLite (":memory:" apenas para testes)
DATABASE_PATH=./var/app.db
# Diretório de mídia (fora de qualquer pasta servida estaticamente)
MEDIA_DIR=./var/media
# Segredo HMAC para URLs assinadas de mídia. Obrigatório em produção (>= 32 caracteres aleatórios).
MEDIA_URL_SECRET=
# URL pública do app, usada nos links de e-mail (verificação e redefinição de senha)
PUBLIC_APP_URL=http://localhost:5173
# Origens permitidas para CORS, separadas por vírgula. Vazio = nenhuma origem cross-site.
CORS_ORIGINS=http://localhost:5173
# true somente atrás de um proxy reverso confiável que define X-Forwarded-For
TRUST_PROXY=false
